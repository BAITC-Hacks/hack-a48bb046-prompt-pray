# Скопируйте в .env:  cp .env.example .env   (start.* и dev.* делают это сами при первом запуске)
# .env в git НЕ коммитится.
#
# Значения ниже с префиксом "dev-only" годятся только для локальной разработки:
# при ENV=production сервисы откажутся стартовать с такими секретами.
# Для prod сгенерируйте свои:  python scripts/generate_secrets.py

# ---------------------------------------------------------------- Окружение
ENV=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------- Хранилище (для start.bat / start.sh)
# sqlite   — файлы data/<сервис>.db, ничего устанавливать не нужно (для разработки и тестирования)
# postgres — контейнер postgres из docker-compose, параметры ниже (раздел PostgreSQL)
# Флаг перекрывает значение: start.bat --db postgres. Docker Compose (dev.*/prod.*) всегда использует PostgreSQL.
DB_BACKEND=sqlite

# ---------------------------------------------------------------- Порты на хосте
API_GATEWAY_PORT=8000      # публичный вход, публикуется всегда
# Ниже — для dev-режима (docker-compose.dev.yml и start.*), привязаны к 127.0.0.1
AUTH_SERVICE_PORT=8001
EXAMPLE_SERVICE_PORT=8002
AI_SERVICE_PORT=8003
CATALOG_SERVICE_PORT=8004
POSTGRES_PORT=5432

# ---------------------------------------------------------------- JWT
# Общий секрет: auth_service подписывает токены, остальные — проверяют. Минимум 32 символа.
JWT_SECRET_KEY=dev-only-insecure-jwt-key-change-me-0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------- PostgreSQL
# Админ-доступ нужен только контейнеру postgres для создания баз при первом старте
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=dev-only-admin-password

# У каждого сервиса своя БД и свой пользователь (создаются postgres-init/01-create-databases.sh)
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=dev-only-auth-db-password

EXAMPLE_DB_NAME=example_db
EXAMPLE_DB_USER=example_user
EXAMPLE_DB_PASSWORD=dev-only-example-db-password

CATALOG_DB_NAME=catalog_db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=dev-only-catalog-db-password

# ---------------------------------------------------------------- API Gateway
# Разрешённые origin'ы браузерных клиентов, через запятую.
# В production обязательно указать конкретные адреса (без "*").
# В dev, если не задано, разрешены http://localhost:3000 и http://localhost:5173
BACKEND_CORS_ORIGINS=

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# true — только если gateway стоит за доверенным прокси (nginx, Traefik, облачный балансировщик),
# который сам выставляет X-Forwarded-For. Иначе клиент сможет подделать свой IP и обойти лимиты.
TRUST_PROXY_HEADERS=false
# Адреса доверенных Nuxt-прокси. Для Docker укажите IP Nuxt или изолированную подсеть.
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128

# ---------------------------------------------------------------- OpenAI (ai_service; нужен catalog_service для уточняющих вопросов)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MAX_OUTPUT_TOKENS=2048
OPENAI_TIMEOUT=60
# Таймаут gateway должен быть больше OPENAI_TIMEOUT.
AI_UPSTREAM_TIMEOUT=65
# start.* и Docker задают URL автоматически; для ручного запуска:
AI_SERVICE_URL=http://localhost:8003
CATALOG_SERVICE_URL=http://localhost:8004
