# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Public gateway URL, including the API version (no service ports).
NUXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
# For direct browser requests, set BACKEND_CORS_ORIGINS on the gateway
# to the frontend origin. Development defaults already allow http://localhost:3000.
