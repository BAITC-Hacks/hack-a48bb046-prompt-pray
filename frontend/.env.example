# Optional public URL for metadata
NUXT_PUBLIC_SITE_URL=

# Browser requests stay on the frontend origin; only Nitro calls the gateway.
NUXT_PUBLIC_API_BASE=/api/gateway
NUXT_GATEWAY_URL=http://127.0.0.1:8000

# External origin in production, e.g. https://tasks.example.com (no path).
# Leave empty for local development.
NUXT_APP_ORIGIN=
# Enable only behind a trusted proxy; see deploy/nginx.conf.example.
NUXT_TRUST_PROXY_HEADERS=false
